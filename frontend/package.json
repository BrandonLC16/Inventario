{
  "name": "inventory-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "build:development": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "generate:api": "node scripts/generate-api.mjs",
    "generate:api:check": "node scripts/check-api-client-sync.mjs",
    "check": "npm run format:check && npm run lint && npm test && npm run build:development && npm run build"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "dependencies": {
    "@angular/cdk": "22.0.6",
    "@angular/common": "22.0.6",
    "@angular/compiler": "22.0.6",
    "@angular/core": "22.0.6",
    "@angular/forms": "22.0.6",
    "@angular/material": "22.0.6",
    "@angular/platform-browser": "22.0.6",
    "@angular/router": "22.0.6",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.4",
    "@angular/cli": "22.0.6",
    "@angular/compiler-cli": "22.0.6",
    "@eslint/js": "10.0.1",
    "@openapitools/openapi-generator-cli": "2.40.1",
    "angular-eslint": "22.1.0",
    "eslint": "10.8.1",
    "jsdom": "28.0.0",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
