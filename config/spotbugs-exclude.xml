<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- DTO collections are defensively copied; SpotBugs does not infer JDK immutable collections. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="~com\.example\.inventory\.(auth\.CurrentUserResponse|auth\.RefreshTokenService\$RotatedRefreshToken|counts\.CreateInventoryCountRequest|counts\.InventoryCountResponse|inventory\.StockMovementPageResponse|orders\.CreateOrderRequest|orders\.OrderResponse|orders\.UpdateOrderItemsRequest|purchases\.CreatePurchaseOrderRequest|purchases\.CreatePurchaseReceiptRequest|purchases\.PurchaseOrderResponse|purchases\.PurchaseReceiptResponse|purchases\.UpdatePurchaseOrderItemsRequest|security\.InventoryUserDetails|security\.SecurityProperties\$Cors|shared\.ApiError|shared\.PageResponse|transfers\.CreateInventoryTransferRequest|transfers\.InventoryTransferResponse|transfers\.UpdateInventoryTransferItemsRequest|users\.CreateUserRequest|users\.UpdateUserRolesRequest|users\.UserResponse)"/>
    </Match>
    <!-- Constructor injection intentionally retains Spring-managed collaborators. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="~com\.example\.inventory\.(auth\.AuthController|auth\.RefreshTokenService\$RotatedRefreshToken|counts\.InventoryCountController|orders\.OrderController|purchases\.PurchaseOrderController|security\.SecurityErrorHandler|transfers\.InventoryTransferController|users\.UserController)"/>
    </Match>
</FindBugsFilter>
